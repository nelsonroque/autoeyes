{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cognitive-studio/strategy.schema.json",
  "title": "Cognitive Assessment Automation Strategy",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "assessmentUrl", "mode", "viewport", "steps", "metadata", "parameters", "completion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "assessmentUrl": { "type": "string", "format": "uri" },
    "mode": { "enum": ["scripted", "ai", "simulated", "dom"] },
    "viewport": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 } } },
    "parameters": { "type": "object" },
    "metadata": { "type": "object", "required": ["createdAt", "updatedAt"], "properties": { "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "learnedByAI": { "type": "boolean" }, "recordingScreenshots": { "type": "array", "items": { "type": "string" } } } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "completion": { "type": "object", "properties": { "maxDurationMs": { "type": "integer", "minimum": 1 }, "maxActions": { "type": "integer", "minimum": 1 } } }
  },
  "$defs": { "step": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["click", "move", "keypress", "type", "wait", "waitForVisualChange", "screenshot", "loop", "branch", "domClick", "domType"] }, "delayMs": { "type": "integer", "minimum": 0 } }, "additionalProperties": true } }
}
